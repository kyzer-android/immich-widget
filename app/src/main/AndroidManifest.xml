<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès réseau pour interroger l'API Immich -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Nécessaire pour que WorkManager puisse se relancer après un reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ImmichWidget">

        <!-- Activité de config, ouverte via l'icône ⚙️ du widget -->
        <activity
            android:name=".config.WidgetConfigActivity"
            android:exported="false"
            android:label="@string/config_title"
            android:theme="@style/Theme.ImmichWidget" />

        <!-- Le widget lui-même -->
        <receiver
            android:name=".widget.PhotoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Tick du changement automatique de photo (AlarmManager) + reprogrammation après reboot -->
        <receiver
            android:name=".sync.AutoChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
