<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Fond flouté (vignette réduite, centerCrop) : remplit joliment les bandes du fitCenter -->
    <ImageView
        android:id="@+id/memory_fullscreen_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Voile sombre : garde le texte/icônes lisibles quelles que soient les couleurs de la photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ImageView
        android:id="@+id/memory_fullscreen_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Dégradés non-interactifs : ne bloquent pas le swipe posé sur l'ImageView en dessous -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom" />

    <!-- Barre de progression façon story : 1 segment par photo du souvenir, rempli au fil du défilement -->
    <LinearLayout
        android:id="@+id/progress_segments_container"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        android:orientation="horizontal" />

    <!-- Croix fermer, haut-gauche -->
    <ImageView
        android:id="@+id/memory_fullscreen_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="28dp"
        android:layout_marginStart="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/content_desc_close" />

    <!-- Mute/unmute, haut-droite -->
    <ImageView
        android:id="@+id/memory_fullscreen_mute"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_volume_on"
        android:contentDescription="@string/content_desc_mute" />

    <!-- Badge date, bas-gauche : "Il y a X ans" + date complète -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memory_fullscreen_years_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/memory_fullscreen_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
