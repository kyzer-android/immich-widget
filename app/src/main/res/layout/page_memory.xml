<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_memory_intro"
            android:textColor="@color/config_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_sync_memory_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_sync_memory_now" />

        <TextView
            android:id="@+id/text_memory_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            android:textColor="@color/config_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_slide_duration"
            android:textColor="@color/config_text"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_slide_duration_minus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="−"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/text_slide_duration_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_slide_duration_plus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="20sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_audio"
            android:textColor="@color/config_text"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_audio_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/label_audio_default_switch"
            android:textColor="@color/config_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_audio_default_switch"
            android:textColor="@color/config_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
