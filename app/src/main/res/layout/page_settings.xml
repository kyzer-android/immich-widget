<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/banner_battery_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/banner_warning_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_battery_optimization_warning"
                android:textColor="@color/config_text" />

            <Button
                android:id="@+id/btn_open_battery_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/btn_open_battery_settings" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_server_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/config_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_api_key"
            app:endIconContentDescription="@string/content_desc_api_key_info"
            app:endIconDrawable="@drawable/ic_info"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/config_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_test_connection" />

        <TextView
            android:id="@+id/text_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            android:textColor="@color/config_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_source_mode"
            android:textColor="@color/config_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_group_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_source_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_source_album"
                android:textColor="@color/config_text" />

            <RadioButton
                android:id="@+id/radio_source_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_source_memory"
                android:textColor="@color/config_text" />

            <RadioButton
                android:id="@+id/radio_source_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_source_both"
                android:textColor="@color/config_text" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_display_mode"
            android:textColor="@color/config_text"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_crop_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/label_crop_switch"
            android:textColor="@color/config_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_crop_switch"
            android:textColor="@color/config_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_auto_interval"
            android:textColor="@color/config_text"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_interval_minus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="−"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/text_interval_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/label_interval_disabled"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_interval_plus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="20sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_auto_interval_shared"
            android:textColor="@color/config_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
