<?xml version="1.0" encoding="utf-8"?>
<!--
    2 ImageView superposées à la même position (crop / fit) : RemoteViews ne
    permet pas de changer le scaleType d'une ImageView existante par code (pas
    de setter compatible avec setInt/setBoolean/etc.), donc on prépare les
    deux variantes dans le layout et on bascule leur visibilité côté code
    (WidgetUpdateHelper) selon le mode choisi par l'utilisateur.

    widget_click_area regroupe tout le contenu cliquable : le PendingIntent
    "photo suivante" est posé sur ce conteneur, pas sur chaque ImageView
    individuellement.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_click_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Mode "crop" : remplit tout le cadre, recadre si besoin -->
        <ImageView
            android:id="@+id/widget_image_crop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_label" />

        <!-- Mode "fit" : image entière visible, bandes si le ratio ne correspond pas -->
        <ImageView
            android:id="@+id/widget_image_fit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/widget_label" />

    </FrameLayout>

    <!-- Petite icône ⛶ en coin haut-droit : tap = ouvre le plein écran -->
    <FrameLayout
        android:id="@+id/widget_fullscreen_zone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_icon_circle_bg">

        <ImageView
            android:id="@+id/widget_fullscreen_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="@string/content_desc_fullscreen" />
    </FrameLayout>

    <!-- Toggle Album/Memory, coin haut-gauche : visible seulement si sourceMode == BOTH -->
    <LinearLayout
        android:id="@+id/widget_mode_toggle_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/widget_mode_album_zone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_icon_circle_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_album"
                android:contentDescription="@string/content_desc_mode_album" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_mode_memory_zone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_icon_circle_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_memory"
                android:contentDescription="@string/content_desc_mode_memory" />
        </FrameLayout>

    </LinearLayout>

    <!-- Badge "il y a X ans", coin bas-gauche : visible seulement en mode Memory -->
    <TextView
        android:id="@+id/widget_memory_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/widget_icon_circle_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Petite icône ⚙️ en coin bas-droit : tap = ouvre la config -->
    <FrameLayout
        android:id="@+id/widget_settings_zone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_icon_circle_bg">

        <ImageView
            android:id="@+id/widget_settings_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/config_title" />
    </FrameLayout>

</FrameLayout>
