    <string name="title_api_key_info">Permissions requises</string>
    <string name="msg_api_key_info">Coche uniquement ces permissions lors de la création de la clé API dans Immich :\n\n• album.read — lister les albums et leurs photos\n• asset.read — métadonnées des photos\n• asset.view — accès aux vignettes\n• memory.read — accès aux Souvenirs du jour\n\n⚠️ Sur Immich antérieur à la version 1.138.0, les permissions fines n\'existent pas encore : coche « all » à la place.</string>
